# Copy to .env. NEVER commit .env.
LOG_LEVEL=INFO

# Docker build: 1 = install PyTorch CPU + Ultralytics in the API image, 0 = API without detector
WITH_ML=1

# Model registry: models/<MODEL_VERSION>/weights.pt
MODEL_DIR=models
MODEL_VERSION=yolov8n-pretrained
DEVICE=cpu
IMGSZ=1024

# Post-processing
CONF_THRESHOLD=0.25
GAP_WIDTH_MULTIPLIER=1.5
FILL_RATE_ALERT_THRESHOLD=0.80

# Input limits
MAX_UPLOAD_MB=10
MAX_IMAGE_SIDE=1920

# Storage
DATABASE_URL=sqlite:///var/shelfmon.db
IMAGE_DIR=var/images

# Optional webhook (Telegram / Slack)
ALERT_WEBHOOK_URL=
