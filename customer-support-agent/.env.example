# Copy to .env and fill in. NEVER commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM (FR-01, NFR-07). provider: mock | openai | ollama ---
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
# Ollama example:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Prompts & agent behaviour (NFR-08) ---
PROMPT_VERSION=v1
AGENT_CONFIG=configs/agent.yaml

# --- Retrieval (FR-02, FR-03) ---
KB_DIR=kb
VECTOR_STORE_DIR=var/vector_store
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Services ---
ORDER_API_URL=http://localhost:8001
ORDERS_FILE=var/orders.json
DATABASE_URL=sqlite:///var/support.db
