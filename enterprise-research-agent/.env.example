# Copy to .env. NEVER commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Local (non-Docker) defaults; docker-compose.yml overrides the hosts.
DATABASE_URL=postgresql+psycopg://era:era@localhost:5432/era
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

MAX_UPLOAD_MB=20

# provider: mock | openai | ollama | gemini
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_API_KEY=

# Set this when using Gemini for generation or embeddings.
GEMINI_API_KEY=

# --- Embedding (ERA-11) ---
# provider: local | gemini. Ingest and retrieval MUST use the same provider; changing it needs a re-ingest.
EMBEDDING_PROVIDER=local
# local: sentence-transformers is included in Docker. For host Python, install `.[embeddings]`.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# gemini: API model (requires GEMINI_API_KEY).
EMBEDDING_MODEL=gemini-embedding-2
# Must match Vector(384) in app/models/document.py
EMBEDDING_DIM=384
# Maximum input texts per minute per process for Gemini embeddings.
EMBEDDING_MAX_TEXTS_PER_MINUTE=80
